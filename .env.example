# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careloop?schema=public"

# Session signing secret (use a strong 32+ char secret in production)
AUTH_SECRET="careloop-dev-only-secret-change-in-production-2026"

# AI Provider mode: "deterministic" (default/offline) | "openai"
AI_PROVIDER_MODE="deterministic"
AI_MODEL_NAME="careloop-rules-v1"

# Optional external LLM configuration (only used when AI_PROVIDER_MODE=openai)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Logging & App settings
LOG_LEVEL="info"
NODE_ENV="development"
COMMUNICATION_DELIVERY_MODE="mock"
ALLOW_LIVE_COMMUNICATIONS="false"
APP_DEMO_MODE="true"

# NOTE FOR PRODUCTION:
# - NODE_ENV="production" rejects startup if AUTH_SECRET is < 32 chars or uses the dev fallback string.
# - Set APP_DEMO_MODE="false" to disable demo quick-sign-in cards and prefilled credentials on /login.
